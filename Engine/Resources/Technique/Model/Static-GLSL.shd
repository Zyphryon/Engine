// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
// Uniforms
// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-

layout(std140) uniform cb_Global
{
    mat4 u_Camera;
};

// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
// Vertex
// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-

#ifdef   VERTEX_SHADER

in vec3 a_Position;
in vec3 a_Normal;
in vec2 a_Texture;
in vec4 a_Row0;
in vec4 a_Row1;
in vec4 a_Row2;

out vec3 v_Normal;
out vec2 v_Texture;

void main()
{
    const vec4 Local  = vec4(a_Position, 1.0);
    const vec3 World  = vec3(dot(a_Row0, Local), dot(a_Row1, Local), dot(a_Row2, Local));

    const vec3 Normal = vec3(
        dot(normalize(a_Row0.xyz), a_Normal),
        dot(normalize(a_Row1.xyz), a_Normal),
        dot(normalize(a_Row2.xyz), a_Normal));

    gl_Position = u_Camera * vec4(World, 1.0);
    v_Normal    = Normal;
    v_Texture   = a_Texture;
}

#endif // VERTEX_SHADER

// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-
// Fragment
// -=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-=-

#ifdef FRAGMENT_SHADER

uniform sampler2D s_Albedo;

in  vec3 v_Normal;
in  vec2 v_Texture;

out vec4 o_Target;

void main()
{
    const vec4 Texel = texture(s_Albedo, v_Texture);

    // A fixed half-lambert sun so unlit geometry still reads as shaped rather than flat.
    float Wrap = clamp(dot(normalize(v_Normal), normalize(vec3(0.4, 0.8, 0.3))), 0.0, 1.0) * 0.75 + 0.25;

    o_Target = vec4(Texel.rgb * Wrap, Texel.a);
}

#endif // FRAGMENT_SHADER
